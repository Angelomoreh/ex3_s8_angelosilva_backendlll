{
  "info": {
    "_postman_id": "b10d3f0e-cfb7-4df0-8d42-banco-xyz-cloud",
    "name": "Banco XYZ Cloud Semana 8",
    "description": "Pruebas de OAuth2, Gateway y BFF para la evaluacion sumativa.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gatewayUrl", "value": "http://localhost:8080" },
    { "key": "keycloakUrl", "value": "http://localhost:8180" },
    { "key": "accessToken", "value": "" },
    { "key": "atmKey", "value": "BANCO-XYZ-ATM-2026" }
  ],
  "item": [
    {
      "name": "01 Obtener token OAuth2",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('accessToken', body.access_token);",
              "pm.test('Token recibido', () => pm.expect(body.access_token).to.be.a('string'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "grant_type", "value": "password", "type": "text" },
            { "key": "client_id", "value": "banco-api", "type": "text" },
            { "key": "username", "value": "angelo", "type": "text" },
            { "key": "password", "value": "angelo123", "type": "text" }
          ]
        },
        "url": "{{keycloakUrl}}/realms/banco-xyz/protocol/openid-connect/token"
      }
    },
    {
      "name": "02 Seguridad sin token HTTP 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Acceso rechazado', () => pm.response.to.have.status(401));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{gatewayUrl}}/api/web/cuentas/101"
      }
    },
    {
      "name": "03 BFF Web seguro",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": "{{gatewayUrl}}/api/web/cuentas/101"
      }
    },
    {
      "name": "04 BFF Mobile seguro",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": "{{gatewayUrl}}/api/mobile/cuentas/101"
      }
    },
    {
      "name": "05 BFF ATM saldo",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "method": "GET",
        "header": [{ "key": "X-ATM-KEY", "value": "{{atmKey}}" }],
        "url": "{{gatewayUrl}}/api/atm/cuentas/101/saldo"
      }
    },
    {
      "name": "06 BFF ATM retiro con evento Kafka",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "method": "POST",
        "header": [
          { "key": "X-ATM-KEY", "value": "{{atmKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"monto\": 500\n}" },
        "url": "{{gatewayUrl}}/api/atm/cuentas/101/retiros"
      }
    }
  ]
}
